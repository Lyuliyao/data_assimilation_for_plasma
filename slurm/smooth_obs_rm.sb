#!/bin/bash
# Bridges-2 RM: run save_smoothed_observation.py to produce
# observation_smoothed.npz from a truth.npz already on disk.
#
# Submit with:
#   sbatch slurm/smooth_obs_rm.sb results/current_mismatch combined_heavy

#SBATCH --job-name=mfda-smooth
#SBATCH --partition=RM-shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=30G
#SBATCH --time=00:30:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH -A mth210003p

set -euo pipefail
mkdir -p logs results

module load anaconda3/2024.10-1
source /opt/packages/anaconda3-2024.10-1/etc/profile.d/conda.sh
conda activate mfda

TRUTH_DIR="${1:?truth dir required}"
METHOD="${2:-combined_heavy}"

srun python scripts/save_smoothed_observation.py \
    --truth-dir "${TRUTH_DIR}" \
    --method "${METHOD}"
