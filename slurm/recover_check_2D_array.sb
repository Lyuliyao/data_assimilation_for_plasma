#!/bin/bash
# Bridges-2 RM-shared template for the 2D2V recover-check.
# Array job: one task per formulation (0=none, 1=A_var, 2=B).
#
# Don't sbatch this directly -- use slurm/submit_recover_check_2D.sh, which
# pairs this with the dependent aggregator job.

#SBATCH --job-name=mfda-recover-2D
#SBATCH --partition=RM-shared
#SBATCH --array=0-4
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=30G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x-%A_%a.out
#SBATCH --error=logs/%x-%A_%a.err
#SBATCH -A mth210003p

set -euo pipefail
unset SLURM_MEM_PER_CPU SLURM_MEM_PER_NODE SLURM_MEM_PER_GPU 2>/dev/null || true
mkdir -p logs results

module load anaconda3/2024.10-1
source /opt/packages/anaconda3-2024.10-1/etc/profile.d/conda.sh
conda activate mfda

CONFIG="${1:?usage: sbatch --array=0-4 recover_check_2D_array.sb CONFIG.yaml}"

python scripts/run_recover_single_2D.py --config "${CONFIG}"
