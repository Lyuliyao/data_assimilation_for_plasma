#!/bin/bash
# Bridges-2 RM template: ONE assim run with snapshot saves + immediate plot.
# Costs the same as one mfda.assimilation.run() call (no re-runs).
#
# Submit with:
#   sbatch slurm/run_with_snapshots_rm.sb \
#       configs/test0_identifiability_linear_combined5_best.yaml

#SBATCH --job-name=mfda-snap
#SBATCH --partition=RM-shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=30G
#SBATCH --time=03:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH -A mth210003p

set -euo pipefail
mkdir -p logs results

module load anaconda3/2024.10-1
source /opt/packages/anaconda3-2024.10-1/etc/profile.d/conda.sh
conda activate mfda

CONFIG="${1:?config yaml required}"

srun python scripts/run_with_snapshots.py --config "${CONFIG}"
srun python scripts/plot_from_snapshots.py --config "${CONFIG}"
