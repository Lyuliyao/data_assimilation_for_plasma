#!/bin/bash
# Bridges-2 RM template that runs velocity vs position nudging back-to-back
# and writes the comparison table + plot.
#
# Submit with:
#   sbatch slurm/compare_rm.sb configs/test1_linear_landau.yaml 1.0

#SBATCH --job-name=mfda-compare
#SBATCH --partition=RM-shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=30G
#SBATCH --time=08:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH -A mth210003p

set -euo pipefail
mkdir -p logs results

module load anaconda3/2024.10-1
source /opt/packages/anaconda3-2024.10-1/etc/profile.d/conda.sh
conda activate mfda

CONFIG="${1:-configs/test1_linear_landau.yaml}"
GAMMA="${2:-1.0}"

srun python scripts/compare_velocity_vs_position.py \
    --config "${CONFIG}" \
    --gamma "${GAMMA}" \
    --plot
