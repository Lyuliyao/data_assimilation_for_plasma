#!/bin/bash
# Bridges-2 RM template for an alpha sweep on the time-derivative observation
# channel, single (config, variant, gamma) triple.
# Writes results/<cfg.name>/alpha_sweep_<variant>.csv.
#
# Submit with (alphas + seeds as quoted space-separated lists):
#   sbatch slurm/sweep_alpha_rm.sb configs/test0_identifiability_strong_dtobs.yaml \
#          velocity 1.0 "0.0 0.3 1.0 3.0" "0 1 2"
#
# Args: CONFIG VARIANT GAMMA ALPHAS [SEEDS]

#SBATCH --job-name=mfda-sweep-alpha
#SBATCH --partition=RM-shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=30G
#SBATCH --time=12:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH -A mth210003p

set -euo pipefail
mkdir -p logs results

module load anaconda3/2024.10-1
source /opt/packages/anaconda3-2024.10-1/etc/profile.d/conda.sh
conda activate mfda

CONFIG="${1:?config yaml required}"
VARIANT="${2:?variant required (velocity|position|none)}"
GAMMA="${3:?gamma required (float)}"
ALPHAS="${4:?alphas required as quoted space-separated list}"
SEEDS="${5:-0}"

# Word-split the quoted alphas/seeds back into argv lists for argparse.
# shellcheck disable=SC2086
srun python scripts/sweep_alpha.py \
    --config "${CONFIG}" \
    --variant "${VARIANT}" \
    --gamma "${GAMMA}" \
    --alphas ${ALPHAS} \
    --seeds ${SEEDS}
