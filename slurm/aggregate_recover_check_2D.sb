#!/bin/bash
# Aggregator for the 2D2V recover-check array. Reads
# results/<name>/{none,A_var,B}.npz and writes plots + SUMMARY.
#
# Submitted by slurm/submit_recover_check_2D.sh with a dependency on the
# array job, so it only runs after all 3 formulations complete.

#SBATCH --job-name=mfda-recover-2D-agg
#SBATCH --partition=RM-shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=4G
#SBATCH --time=00:20:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH -A mth210003p

set -euo pipefail
unset SLURM_MEM_PER_CPU SLURM_MEM_PER_NODE SLURM_MEM_PER_GPU 2>/dev/null || true
mkdir -p logs

module load anaconda3/2024.10-1
source /opt/packages/anaconda3-2024.10-1/etc/profile.d/conda.sh
conda activate mfda

CONFIG="${1:?usage: sbatch aggregate_recover_check_2D.sb CONFIG.yaml}"

python scripts/aggregate_recover_check_2D.py --config "${CONFIG}"
